# ═══════════════════════════════════════════
# MissionMind — Environment Configuration
# ═══════════════════════════════════════════

# Application
APP_ENV=development
DEMO_MODE=false

# Database (SQLite for MVP)
DATABASE_URL=sqlite:///./data/generated/missionmind.db

# LLM Provider: "hosted" or "ollama"
LLM_PROVIDER=hosted
LLM_API_KEY=your_api_key_here
LLM_MODEL=gemini-2.0-flash
# LLM_BASE_URL=http://localhost:11434   # For Ollama
LLM_TEMPERATURE=0

# Embeddings
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Retrieval
RETRIEVAL_TOP_K=20
RETRIEVAL_MIN_STRENGTH=0.3

# CORS
CORS_ORIGINS=http://localhost:5173

# Validation
MAX_DROPPED_CLAIMS_BEFORE_ABSTAIN=3
